# Copia este archivo como .env y ajusta lo que necesites. Todo es opcional.

PORT=3000

# Detrás de un proxy inverso (Nginx, Caddy, Render, Railway…) pon 1 para que
# los límites por cliente usen la IP real del visitante.
# TRUST_PROXY=1

# Descarga de YouTube mediante yt-dlp (activada si yt-dlp está instalado).
# Pon false para que los enlaces de YouTube solo muestren información.
# YOUTUBE_DOWNLOADS=true
# Ruta de yt-dlp si no está en el PATH ni instalado como módulo de Python.
# YTDLP_PATH=

# Dominios (https) desde los que se aceptan enlaces directos a archivos,
# separados por comas. Añade aquí tu propio hosting o CDN.
# DIRECT_HOSTS=upload.wikimedia.org,media.midominio.com

# PEERTUBE_ENABLED=true

# Identificación ante las fuentes. Wikimedia recomienda incluir una URL o
# correo de contacto del operador para evitar límites estrictos.
# HTTP_USER_AGENT=Auralis/1.0 (https://midominio.com; contacto@midominio.com)

# Límites
# MAX_DURATION_MIN=180
# MAX_SOURCE_MB=2048
# MAX_UPLOAD_MB=1024
# MAX_CONCURRENT_JOBS=2
# MAX_JOBS_PER_CLIENT=2
# MAX_QUEUE=20
# FILE_TTL_MIN=240

# Rutas de ffmpeg/ffprobe si no están en el PATH ni instalados por npm.
# FFMPEG_PATH=
# FFPROBE_PATH=
# TMP_DIR=
