{
  "name": "auralis",
  "version": "1.0.0",
  "description": "Plataforma web para descargar y convertir video y audio desde fuentes que permiten expresamente la descarga.",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
